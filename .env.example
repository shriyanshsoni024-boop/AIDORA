# =============================================================================
# AIDORA Cooperative Platform — Environment Configuration Template
# SIH Problem Statement 26089
# =============================================================================
#
# QUICK START GUIDE:
# 1. Local Development:
#    Copy this file to `.env.local` or `.env` and fill in your development keys.
# 2. Production Deployment (Vercel):
#    Add these environment variable keys in Vercel Project Settings -> Environment Variables.
#
# NEVER commit real secret keys, service-role keys, or private tokens to GitHub.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (Required for Live DB & Realtime Sync)
# -----------------------------------------------------------------------------
# Obtain from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# -----------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY (Required for Live / Test Online Checkout)
# -----------------------------------------------------------------------------
# Obtain from Razorpay Dashboard: Settings -> API Keys -> Key Id (rzp_test_... or rzp_live_...)
# Note: Razorpay Key Secret must NEVER be put in frontend client-side code.
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# -----------------------------------------------------------------------------
# 3. GOOGLE GEMINI 1.5 FLASH (Optional - for AI Multimodal Photo Estimator)
# -----------------------------------------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/)
# If omitted, AIDORA automatically utilizes its built-in heuristic diagnosis engine.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 4. OPTIONAL BACKEND API / MICROSERVICE URL
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
